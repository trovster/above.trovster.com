{
  "name": "above",
  "version": "0.0.1",
  "description": "Aerial landscape photography, from around Lincolnshire, captured by Trevor Morris.",
  "keywords": [],
  "homepage": "https://above.trovster.com",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "author": {
    "name": "Trevor Morris",
    "url": "https://www.trovster.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trovster/photos-website.git"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "11ty": "eleventy $npm_config_pathprefix",
    "prepare": "npm run hooks:install",
    "hooks:install": "git config core.hooksPath .githooks",
    "prestart": "npm run clean",
    "start": "eleventy $npm_config_pathprefix --serve --quiet",
    "prebuild": "npm run clean",
    "build": "npm run image:process:photos && eleventy $npm_config_pathprefix",
    "image:metadata": "node scripts/update-photo-metadata.js",
    "image:process": "node scripts/process-image.js",
    "image:process:photos": "node scripts/process-photo-images.js",
    "mastodon:post": "node scripts/post-photo-to-mastodon.js",
    "test": "node --test",
    "prettier": "npx prettier --write ."
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-fetch": "^5",
    "@11ty/eleventy-img": "^7",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-vite": "^8.0.0",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "colorthief": "^3.5.0",
    "dotenv": "^17.4.2",
    "exifr": "^7.1.3",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "pannellum": "^2.5.7"
  }
}
