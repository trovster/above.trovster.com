{
  "name": "above",
  "version": "0.0.1",
  "description": "Aerial landscape photography, from around Lincolnshire, captured by Trevor Morris.",
  "keywords": [],
  "homepage": "https://above.trovster.com",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "author": {
    "name": "Trevor Morris",
    "url": "https://www.trovster.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trovster/photos-website.git"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "11ty": "eleventy $npm_config_pathprefix",
    "prepare": "npm run hooks:install",
    "hooks:install": "git config core.hooksPath .githooks",
    "prestart": "npm run clean",
    "start": "eleventy $npm_config_pathprefix --serve --quiet",
    "prebuild": "npm run clean",
    "build": "eleventy $npm_config_pathprefix",
    "image:process": "node scripts/process-image.js",
    "image:process:photos": "node scripts/process-photo-images.js",
    "test": "node --test",
    "prettier": "npx prettier --write ."
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-fetch": "^4.0.1",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "colorthief": "^3.3.1",
    "dotenv": "^16.4.5",
    "exifr": "^7.1.3",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "vite": "^8.2.0"
  }
}
