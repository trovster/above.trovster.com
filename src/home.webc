<section class="gallery" aria-labelledby="gallery-title">
    <header>
        <p class="lede">
            Aerial landscape photography, from around Lincolnshire,
            captured by <strong @text="profile.name"></strong>.
        </p>
    </header>

    <ol data-photo-list>
        <li webc:for="(index, photo) in paginatedPhotos">
            <photo-card :photo="photo"></photo-card>
        </li>
    </ol>

    <photo-pagination :pagination="pagination"></photo-pagination>
</section>
