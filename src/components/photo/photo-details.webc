<article class="photo-detail">
    <figure webc:if="photo.data.viewer !== 'pannellum'">
        <canvas
            webc:if="photo.data.blurhash"
            :data-blurhash="photo.data.blurhash"
            data-blurhash-width="32"
            data-blurhash-height="18"
            aria-hidden="true"
        ></canvas>

        <img
            :src="photo.data.src"
            :alt="photo.data.alt"
            width="2500"
            height="1406"
            eleventy:widths="400,800,1200,1400,auto"
            sizes="100vw"
            :eleventy:output="photo.url"
        />
    </figure>

    <figure
        webc:if="photo.data.viewer === 'pannellum'"
        class="photo-panorama"
        data-panorama-viewer
        :aria-label="`360 panorama viewer for ${photo.data.title}`"
    >
        <canvas
            webc:if="photo.data.blurhash"
            :data-blurhash="photo.data.blurhash"
            data-blurhash-width="32"
            data-blurhash-height="16"
            aria-hidden="true"
        ></canvas>

        <img
            :src="photo.data.src"
            :alt="photo.data.alt"
            width="6000"
            height="3000"
            eleventy:widths="1200,1400,2500,3600,auto"
            sizes="100vw"
            :eleventy:output="photo.url"
            data-panorama-image
        />

        <div class="photo-panorama__mount" data-panorama-mount aria-hidden="true"></div>
    </figure>

    <photo-palette :palette="photo.data.palette"></photo-palette>

    <header>
        <p webc:if="photo.data.category" class="pre-title" @text="photo.data.category"></p>

        <div>
            <h1 @text="photo.data.title"></h1>
            <div class="photo-detail-actions">
                <photo-panorama-button :photo="photo"></photo-panorama-button>
                <photo-exif-button :photo="photo"></photo-exif-button>
            </div>
        </div>

        <p>Taken on <time @text="date(photo.date, 'cccc dS LLLL y')"></time></p>
    </header>

    <section webc:if="photo.data.gallery" class="photo-gallery">
        <photo-gallery :images="photo.data.gallery.images" :id="photo.data.id"></photo-gallery>
    </section>

    <div webc:if="photo.data.viewer !== 'pannellum'">
        <section webc:if="description?.trim() || photo.data.wikipedia?.url" aria-labelledby="photo-description-title">
            <p class="pre-title">Field Notes</p>
            <h2 id="photo-description-title" @text="description?.trim() ? 'Description' : 'Source'"></h2>
            <div webc:if="description?.trim()" @raw="description" class="prose"></div>
            <p webc:if="photo.data.wikipedia?.url" class="prose photo-source">
                Wikipedia:
                <a :href="photo.data.wikipedia.url" rel="external noopener" @text="photo.data.wikipedia.title || photo.data.title"></a>.
            </p>
        </section>

        <photo-location-map :photo="photo" :apikey="apikey" :mapid="mapid"></photo-location-map>
    </div>

    <photo-exif :photo="photo"></photo-exif>
</article>
