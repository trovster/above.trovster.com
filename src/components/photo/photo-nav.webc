<nav class="photo-nav" aria-label="Photo navigation">
    <a
        webc:if="photo.data.previous"
        :href="photo.data.previous.url"
        rel="prev"
        :title="`Previous Photo: ${photo.data.previous.data.title}`">
        <svg width="26" height="26" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
        </svg>
        <span class="u-visually-hidden">Previous photo</span>
    </a>

    <span webc:if="!photo.data.previous">
        <svg width="26" height="26" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
        </svg>
    </span>

    <site-nav></site-nav>

    <a
        webc:if="photo.data.next"
        :href="photo.data.next.url"
        rel="next"
        :title="`Next Photo: ${photo.data.next.data.title}`">
        <svg width="26" height="26" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
        </svg>
        <span class="u-visually-hidden">Next photo</span>
    </a>

    <span webc:if="!photo.data.next">
        <svg width="26" height="26" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
        </svg>
    </span>
</nav>
