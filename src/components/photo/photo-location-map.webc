<section webc:if="photo.data.map" class="photo-location" aria-labelledby="photo-location-title">
    <div>
        <p class="pre-title">Location</p>
        <h2 id="photo-location-title" @text="photo.data.location.name"></h2>
        <p webc:if="photo.data.location.region" @text="photo.data.location.region"></p>

        <dl webc:if="photo.data.meta?.length">
            <div webc:for="(index, item) in photo.data.meta">
                <dt @text="item.key"></dt>
                <dd @text="item.value"></dd>
            </div>
        </dl>

        <h3>Taken</h3>
        <dl>
            <div>
                <dt>Date</dt>
                <dd><time @text="date(photo.date, 'cccc dS LLLL y')"></time></dd>
            </div>
            <div>
                <dt>Time</dt>
                <dd><time @text="date(photo.date, 'h:mm a')"></time></dd>
            </div>
            <div webc:if="photo.data.weather?.summary">
                <dt>Conditions</dt>
                <dd @text="photo.data.weather.summary"></dd>
            </div>
            <div webc:if="photo.data.weather?.temperature">
                <dt>Temperature</dt>
                <dd @text="photo.data.weather.temperature"></dd>
            </div>
        </dl>

        <a class="link" :href="photo.data.map.linkUrl" rel="external noopener" target="_blank" hidden>View on Google Maps</a>
    </div>

    <div
        class="photo-location-map"
        data-photo-location-map
        :data-api-key="apikey"
        :data-map-id="mapid"
        :data-lat="photo.data.map.latitude"
        :data-lng="photo.data.map.longitude"
        :data-title="photo.data.location.name"
        :data-thumbnail="photo.data.thumbnail"
        aria-label="Location map"
    ></div>
</section>
