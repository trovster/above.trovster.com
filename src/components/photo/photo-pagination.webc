<nav webc:if="pagination.hrefs.length > 1" class="photo-pagination" aria-label="Photo pagination">
    <a webc:if="pagination.href.previous" :href="pagination.href.previous" class="button button--secondary">
        Previous
    </a>

    <a
        webc:if="pagination.href.next"
        :href="pagination.href.next"
        class="button button--secondary"
        rel="next"
        data-photo-list-next
        data-ready-text="Next"
        data-loading-text="Loading…"
    >
        Next
    </a>

    <p
        data-photo-list-status
        aria-live="polite"
        @text="pagination.href.next ? '' : 'End of archive'"
    ></p>
</nav>
