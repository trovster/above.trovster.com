<article class="photo-card">
    <a :href="photo.url" :title="photo.title">
        <figure>
            <canvas
                webc:if="photo.data.blurhash"
                :data-blurhash="photo.data.blurhash"
                data-blurhash-width="32"
                data-blurhash-height="18"
                aria-hidden="true"
            ></canvas>

            <img :src="photo.data.src" :alt="photo.data.alt" loading="lazy" />
        </figure>
    </a>

    <div>
        <p webc:if="photo.data.category" class="pre-title" @text="photo.data.category"></p>
        <h2>
            <a :href="photo.url" @text="photo.data.title"></a>
        </h2>
    </div>
</article>
