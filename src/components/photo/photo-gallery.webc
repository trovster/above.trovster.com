<div class="photo-carousel swiper" :data-count="images.length" data-photo-carousel>
    <div class="swiper-wrapper">
        <div class="swiper-slide" webc:for="(index, image) in images">
            <button
                type="button"
                class="photo-carousel__item"
                aria-haspopup="dialog"
                :popovertarget="`${id}-view-${image.number}`"
                popovertargetaction="show"
            >
                <figure>
                    <canvas
                        webc:if="image.blurhash"
                        :data-blurhash="image.blurhash"
                        data-blurhash-width="32"
                        data-blurhash-height="18"
                        aria-hidden="true"
                    ></canvas>

                    <img
                        :src="image.src"
                        :alt="image.alt"
                        width="1200"
                        height="1600"
                        eleventy:widths="320,400,500,800,1200"
                        sizes="100vw"
                        :eleventy:output="image.url"
                    />

                    <span class="photo-carousel__number" aria-hidden="true" @text="image.number"></span>
                </figure>

                <span class="u-visually-hidden" @text="`Open photo ${image.number} of ${images.length}`"></span>
            </button>

            <dialog
                :id="`${id}-view-${image.number}`"
                popover="auto"
                class="gallery-popover swiper-no-swiping"
                :aria-label="`Expanded view: ${image.alt}`"
            >
                <button
                    type="button"
                    class="metadata-button gallery-popover__close"
                    aria-label="Close expanded photo"
                    :popovertarget="`${id}-view-${image.number}`"
                    popovertargetaction="hide"
                >
                    <svg width="26" height="26" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
                    </svg>
                </button>

                <img
                    :src="image.src"
                    :alt="image.alt"
                    width="1200"
                    height="1600"
                    eleventy:widths="400,800,1200,1400,auto"
                    sizes="100vw"
                    :eleventy:output="image.url"
                />
            </dialog>
        </div>
    </div>

    <button type="button" class="photo-carousel__nav photo-carousel__nav--prev swiper-button-prev" aria-label="Previous photo">
        <svg width="26" height="26" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"></path>
        </svg>
    </button>

    <button type="button" class="photo-carousel__nav photo-carousel__nav--next swiper-button-next" aria-label="Next photo">
        <svg width="26" height="26" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
        </svg>
    </button>
</div>
