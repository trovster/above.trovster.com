<!doctype html>
<html dir="ltr" lang="en" class="no-js">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <meta name="author" :content="site.author"/>
        <meta name="robots" content="index,follow"/>
        <meta name="color-scheme" content="dark"/>

        <meta name="keywords" :content="site.keywords.join(', ')"/>
        <meta name="apple-mobile-web-app-title" :content="site.title"/>
        <meta name="application-name" :content="site.title"/>

        <meta property="og:type" content="website"/>
        <meta property="og:title" :content="title === site.title ? site.title : `${title} | ${site.title}`"/>
        <meta property="og:description" name="description" :content="description ?? site.description"/>
        <meta property="og:site_name" :content="profile.name"/>
        <meta property="og:url" :content="`${site.url}${page.url}`"/>

        <meta webc:if="ogImage" property="og:image" :content="`${site.url}${ogImage.url}`"/>
        <meta webc:if="ogImage" property="og:image:type" content="image/jpeg"/>
        <meta webc:if="ogImage" property="og:image:width" :content="ogImage.width"/>
        <meta webc:if="ogImage" property="og:image:height" :content="ogImage.height"/>
        <meta webc:if="ogImage" property="og:image:alt" :content="ogImage.alt ?? (description ?? site.description)"/>

        <title @text="title === site.title ? `${site.title} – Aerial Landscape Photography` : `${title} | ${site.title}`"></title>

        <script webc:keep>
            document.documentElement.classList.replace("no-js", "js")
        </script>

        <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96"/>
        <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
        <link rel="icon" href="/favicon.ico" sizes="any"/>
        <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>

        <link rel="manifest" href="/site.webmanifest"/>
        <meta name="theme-color" content="#f1d28f"/>

        <link rel="alternate" type="application/atom+xml" :title="site.title" href="/feed.xml"/>
        <link rel="alternate" type="application/feed+json" :title="site.title" href="/feed.json"/>

        <script webc:keep src="/assets/site.js" type="module"></script>
    </head>
    <body :class="bodyClass ?? ''">
        <site-header :profile="profile" :site="site"></site-header>
        <main id="main" class="site-main" @raw="content"></main>
        <site-footer :photo="photo" :view="view"></site-footer>
    </body>
</html>
