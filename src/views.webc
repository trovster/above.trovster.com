<section class="gallery" aria-labelledby="gallery-title">
    <header>
        <p class="lede">
            <strong>More scenic views</strong> from around Lincolnshire.
            Swipe through each set to see more of the place.
        </p>
    </header>

    <ol data-view-list>
        <li webc:for="(index, view) in paginatedViews">
            <view-card :view="view"></view-card>
        </li>
    </ol>

    <photo-pagination :pagination="pagination"></photo-pagination>
</section>
